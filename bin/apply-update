#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
venv="${CI_UI_VENV:-$HOME/.buildbotci}"
env_file="${CI_ENV:-$HOME/bb-master.env}"
pid_file="${CI_UI_PID_FILE:-$venv/ui.pid}"
cd "$here"
set -a; . "$env_file"; set +a
. "$(dirname "${BASH_SOURCE[0]}")/_login"
ci_login apply-update ""
"$venv/bin/pip" install --quiet -r requirements.txt
"$venv/bin/python" manage.py migrate --noinput
"$venv/bin/python" manage.py collectstatic --noinput --verbosity 0
if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
    kill -HUP "$(cat "$pid_file")"
    echo "web UI reloaded with the new code"
else
    echo "web UI is not running; start it with bin/run-ui"
fi
