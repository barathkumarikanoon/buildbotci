#!/usr/bin/env bash
# Remove the old checkouts (git worktrees) that finished, stopped, crashed or killed builds left behind.
#
#   bin/clean-worktrees          while Buildbot runs: removes only checkouts no running build is using
#   bin/clean-worktrees --all    removes every build checkout; use it when Buildbot is stopped
#   Add --repo KEY to look at one repo profile only; the default is all of them.
#
# Buildbot does this by itself too: every build ends by removing its checkout, and every run starts by
# sweeping the leftovers of earlier ones. This command is for the case where nothing is running to do it.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
venv="${CI_UI_VENV:-$HOME/.buildbotci}"
set -a; . "${CI_ENV:-$HOME/bb-master.env}"; set +a
cd "$here"
. "$(dirname "${BASH_SOURCE[0]}")/_login"
ci_has --dry-run "$@" || ci_login clean-worktrees "$*"
exec "$venv/bin/python" runner.py sweep "$@"
