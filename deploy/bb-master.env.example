# Example of ~/bb-master.env with the settings a production server needs. Copy it, fill in the values,
# keep the file readable by its owner only (chmod 600). Lines marked "SET" must be filled in.
# Generate each password/secret with:  python3 -c "import secrets; print(secrets.token_hex(12))"
# Format: one KEY='value' per line, no "export" (systemd's EnvironmentFile= ignores lines that start with it).
# The bin/ scripts load the file with "set -a", and the web UI reads it itself. Put a comment on its own line, not
# after a value.
# Paths: write them as '$HOME/...' (or '~/...') in single quotes. The master, the runner and the web UI expand them
# for the account that runs them, so the same file works on any account. Do not set HOME= here, do not nest variables,
# and use absolute paths in the systemd units and inside BUILDBOT_DB_URL, which expand nothing.

# ================= Buildbot master + workers (same host) =================
BUILDBOT_DB_URL='postgresql+psycopg2://buildbot:CHANGE-ME@localhost/buildbot'
BUILDBOT_WORKER_PASSWORD='CHANGE-ME'
BUILDBOT_ADMIN_PASSWORD='CHANGE-ME'
BUILDBOT_UI_PASSWORD='CHANGE-ME'
BUILDBOT_URL='http://localhost:8010/'
BUILDBOT_WWW_INTERFACE='127.0.0.1'
BUILDBOT_WORKER_INTERFACE='127.0.0.1'

REG_CI_DIR='$HOME/buildbotci'
REG_PYTHON='$HOME/.indianlaw/bin/python'
REG_WORKERS='w1,w2,w3'
REG_MAX_PARALLEL_SHARDS='3'
REG_MAX_SHARDS='20'
REG_BRANCHES='main,2026'
REGRESSION_PROFILE='local'
REG_UI_LOG_LEVEL='INFO'
# Optional: a private file with only the settings that differ on a worker (for example DATADIR). Leave it unset to use .env.<profile> as it is.
# REG_PROFILE_FILE='$HOME/.buildbotci/private/profile.env'
REG_RESULTS_DIR='$HOME/regression-results'
REG_WORKERS_DIR='$HOME/.buildbotci'
REG_CRON_HOUR='21'
REG_CRON_MINUTE='0'
TZ='Asia/Kolkata'

# ================= Django web UI =================
# python3 -c "import secrets; print(secrets.token_hex(32))"
REG_UI_SECRET='CHANGE-ME-long-random-value'
# SET: real public https URL
REG_UI_URL='https://<your-ci-domain>'
REG_UI_DB_SCHEMA='ci'
REG_BUILDBOT_URL='http://localhost:8010/'
REG_BUILDBOT_USER='regression-ui'
# The UI signs in with BUILDBOT_UI_PASSWORD (set above). Set REG_BUILDBOT_PASSWORD only to use a different value.

# HTTPS (nginx terminates TLS)
REG_UI_BEHIND_PROXY='1'
REG_UI_SECURE_COOKIES='1'
# raise to 31536000 after HTTPS is confirmed
REG_UI_HSTS_SECONDS='0'
REG_UI_SSL_REDIRECT='0'

# Accounts / email
# SET: domains auto-confirmed
REG_SIGNUP_DOMAINS='indiankanoon.com'
# SET: SMTP details
REG_SMTP_HOST='<smtp-host>'
REG_SMTP_PORT='587'
REG_SMTP_USER='<smtp-user>'
REG_SMTP_PASSWORD='<smtp-password>'
REG_SMTP_FROM='<from-address>'
REG_SMTP_SECURITY='starttls'
