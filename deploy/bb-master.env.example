# Example of ~/bb-master.env with the settings a production server needs. Copy it, fill in the values,
# keep the file readable by its owner only (chmod 600). Lines marked "SET" must be filled in.
# Generate each password/secret with:  python3 -c "import secrets; print(secrets.token_hex(12))"
# Format: one KEY='value' per line, no "export" (systemd's EnvironmentFile= ignores lines that start with it).
# The bin/ scripts load the file with "set -a", and the web UI reads it itself. Put a comment on its own line, not
# after a value.
# Paths: write them as '$HOME/...' (or '~/...') in single quotes. The master, the runner and the web UI expand them
# for the account that runs them, so the same file works on any account. Do not set HOME= here, do not nest variables,
# and use absolute paths in the systemd units and inside BUILDBOT_DB_URL, which expand nothing.

# ================= Buildbot master + workers (same host) =================
# Settings of the CI as a whole. What belongs to one repository (its folder, Python, branches, test suite type, schedule,
# workers and limits) is NOT here: add and edit repos in the web UI, under "Repos". The master follows those changes by itself.
BUILDBOT_DB_URL='postgresql+psycopg2://buildbot:CHANGE-ME@localhost/cidb?options=-csearch_path%3Dbuildbot'
BUILDBOT_WORKER_PASSWORD='CHANGE-ME'
BUILDBOT_ADMIN_PASSWORD='CHANGE-ME'
BUILDBOT_UI_PASSWORD='CHANGE-ME'
BUILDBOT_URL='http://localhost:8010/'
BUILDBOT_WWW_INTERFACE='127.0.0.1'
BUILDBOT_WORKER_INTERFACE='127.0.0.1'

CI_DIR='$HOME/buildbotci'
# One folder for the results of every repo (each gets its own sub-folder) and for the repo profiles file (profiles.json).
CI_RESULTS_DIR='$HOME/ci-results'
# The folder that holds the worker folders (<name> for each worker of each repo).
CI_WORKERS_DIR='$HOME/.buildbotci'
# Optional: where the web UI writes the repo profiles for the master and the runners. Default: <results folder>/profiles.json
# CI_PROFILES_FILE='$HOME/ci-results/profiles.json'
# Optional: minutes one login for the scripts in bin/ lasts when it is not used (default 30; 0 = every script asks).
# CI_LOGIN_MINUTES='30'
# Scripts in bin/ that change something ask for a website superuser. For a job without a terminal (cron) set the answer
# for that job only, not here:  CI_ADMIN_USER=... CI_ADMIN_PASSWORD=... bin/prune-runs --days 30 --yes
# Optional: set either to 0 to stop the web UI from making worker folders / starting the workers on its own machine when a
# repository is saved (default 1 for both). Use 0 when the workers run on another machine.
# CI_AUTO_CREATE_WORKERS='0'
# CI_AUTO_START_WORKERS='0'
# Optional: how the machine that creates workers reaches the master (default localhost:<BUILDBOT_WORKER_PORT>).
# CI_WORKER_MASTER='localhost:9989'
# Optional: the "Admin" column of Buildbot's workers page (default: CI admin).
# CI_WORKER_ADMIN='CI admin'
TZ='Asia/Kolkata'

# ================= Django web UI =================
# python3 -c "import secrets; print(secrets.token_hex(32))"
CI_UI_SECRET='CHANGE-ME-long-random-value'
# Name shown in the header, the page titles and the emails.
CI_UI_SITE_NAME='Indian Kanoon CI'
# SET: real public https URL
CI_UI_URL='https://<your-ci-domain>'
CI_UI_LOG_LEVEL='INFO'
CI_UI_DB_SCHEMA='ciweb'
CI_UI_DB_URL='postgresql+psycopg2://ci:CHANGE-ME@localhost/cidb'
CI_BUILDBOT_URL='http://localhost:8010/'
CI_BUILDBOT_USER='ci-ui'
# The UI signs in with BUILDBOT_UI_PASSWORD (set above). Set CI_BUILDBOT_PASSWORD only to use a different value.

# HTTPS (nginx terminates TLS)
CI_UI_BEHIND_PROXY='1'
CI_UI_SECURE_COOKIES='1'
# raise to 31536000 after HTTPS is confirmed
CI_UI_HSTS_SECONDS='0'
CI_UI_SSL_REDIRECT='0'

# Accounts / email
# SET: domains auto-confirmed
CI_SIGNUP_DOMAINS='indiankanoon.com'
# SET: SMTP details
CI_SMTP_HOST='<smtp-host>'
CI_SMTP_PORT='587'
CI_SMTP_USER='<smtp-user>'
CI_SMTP_PASSWORD='<smtp-password>'
CI_SMTP_FROM='<from-address>'
CI_SMTP_SECURITY='starttls'
