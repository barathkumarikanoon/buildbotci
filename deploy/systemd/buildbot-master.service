# Buildbot master. Install as /etc/systemd/system/buildbot-master.service, then:
#   systemctl daemon-reload && systemctl enable --now buildbot-master
# Replace "sushant" and the paths with the account and folders you use. systemd does not expand $HOME or %h here (%h is /root for system units).
[Unit]
Description=Regression CI: Buildbot master
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=sushant
WorkingDirectory=/home/sushant
EnvironmentFile=/home/sushant/bb-master.env
# --nodaemon keeps the master in the foreground so that systemd supervises it.
ExecStart=/home/sushant/.buildbotci/bin/buildbot start --nodaemon /home/sushant/.buildbotci/master
ExecReload=/home/sushant/.buildbotci/bin/buildbot reconfig /home/sushant/.buildbotci/master
Restart=on-failure
RestartSec=10
# Work that a crash cut off is retried by the master; keep it from taking the machine down.
MemoryHigh=2G
MemoryMax=3G

[Install]
WantedBy=multi-user.target
